weaponDef
{
/*
valid keys for both and both_altweap

		damage
		spread
		coolRate
		defaultStartingAmmo
		defaultStartingClip
		fireDelayTime
		maxammo
		maxclip
		maxHeat
		mod // well since you have to enter integer it is not perfect yet
		nextShotTime
		reloadTime // no need to specify as it is from animation
		SpreadScaleAdd
		recoilDuration
		recoilYaw // float
		recoilPitch // float

	both {
		nextShotTime  1000
		recoilDuration 250
		recoilPitch .60
		spread 1000
		damage 10
	}
*/
	// This basically fills out weaponInfo_t
	client {
		foreShorten .85
		standModel		"models/weapons2/winchester/winchester_3rd.md3"		// weapon pickup 'stand' (do we still use this?)
		pickupModel		"models/weapons2/winchester/winchester_pickup.md3"
		//pickupSound		"sound/misc/w_pkup.wav"
		bounceSound		"sound/weapons/weaponbounce.wav"
		clipBounceSound		"sound/weapons/clipbounce.wav"
		
		weaponConfig		"models/weapons2/winchester/weapon.cfg"
		handsModel		"models/weapons2/winchester/v_winchester_hand.md3"
		
		flashDlightColor	1.0 0.6 0.23
		flashSound		"sound/weapons/shotgun/shotgun_fire.wav"		// supports up to 4 flash sounds
		flashEchoSound		"sound/weapons/shotgun/shotgun_far.wav"			// supports up to 4 flash echo sounds
		lastShotSound		"sound/weapons/shotgun/shotgun_lastshot.wav"							// supports up to 4 last shot sounds
		
		//readySound		""
		//firingSound		"sound/weapons/shotgun/shotgun_fire.wav"							// no weapons seem to use this, basically it's a replacement hum for readysound, but then when firing
		//overheatSound		""
		reloadSound		"sound/weapons/shotgun/shotgun_addshell.wav"	// normal reload shell
		reloadFastSound		"sound/weapons/shotgun/shotgun_reloadpump.wav"	// reload shell and pump
		//spinupSound		""							// sound started when fire button goes down, and stepped on when the first fire event happens
		//spindownSound		""							// sound called if the above is running but player doesn't follow through and fire
		//switchSound		""							// allow overriding of weaponswitch sound
		
		weaponIcon		"icons/iconw_shotgun"
		weaponSelectedIcon	"icons/iconw_shotgun_1_select"
		
		//missileModel		""
		//missileSound		""
		//missileTrailFunc	""							// supports "GrenadeTrail", "RocketTrail", "PyroSmokeTrail" and "DynamiteTrail" (we REALLY want a particle system for this)
		//missileDlight		0
		//missileDlightColor	0 0 0							// do we still use this?
		
		ejectBrassFunc		"MachineGunEjectBrass"					// supports "MachineGunEjectBrass" and "PanzerFaustEjectBrass"
		brassmodel		"models/weapons2/shells/sgshell.md3"			// specify the shell model that "MachineGunEjectBrass" ejects

		//modModel 1		""
		
		firstPerson {
			model		"models/weapons2/winchester/v_winchester.md3"
			flashModel	"models/weapons2/mp40/v_mp40_flash.mdc"

			// weapon building
			// the parts are numbered because there are some hardcoded references for some weapons to certain parts
			weaponLink
			{				
				part 0
				{
					tag		"tag_slide"
					model	"models/weapons2/winchester/v_winchester_slide.md3"					
					axisskin	"models/weapons2/winchester/winchester_slide_axis.skin"
					alliedskin	"models/weapons2/winchester/winchester_slide_allied.skin"
				}
				part 1
				{
					tag		"tag_carrier"
					model	"models/weapons2/winchester/v_winchester_carrier.md3"
				}
				part 2
				{
					tag		"tag_rarm"
					model		"models/weapons2/winchester/v_winchester_rarm.md3"
					axisskin	"models/weapons2/winchester/winchester_rarm_axis.skin"
					alliedskin	"models/weapons2/winchester/winchester_rarm_allied.skin"
				}
				part 3
				{
					tag		"tag_shell"
					model		"models/weapons2/winchester/v_winchester_shell.md3"
				}
				part 4
				{
					tag		"tag_bolt"
					model		"models/weapons2/winchester/v_winchester_bolt.md3"
				}
				part 5
				{
					tag		"tag_hammer"
					model		"models/weapons2/winchester/v_winchester_hammer.md3"
				}
				part 6
				{
					tag		"tag_sleeve"
					model		"models/weapons2/winchester/v_winchester_sleeve.md3"
				}
				part 7
				{
					tag		"tag_shell2"
					model		"models/weapons2/winchester/v_winchester_shell2.md3"
				}
			}
		}
		
		thirdPerson {
			model		"models/weapons2/winchester/winchester_3rd.md3"
			flashmodel	"models/weapons2/mp40/v_mp40_flash.mdc"
		}
	}
}
