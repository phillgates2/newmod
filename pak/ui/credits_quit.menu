#include "ui/menudef.h"

// Defines //

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	608
#define WINDOW_HEIGHT	448
#define GROUP_NAME		"grpCreditsQuit"

// Macros //

#include "ui/menumacros.h"
		
// Quit Credits Menu //
	
menuDef {
	name		"credits_quit"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		uiScript Quit;
	}

// Window //

	itemDef {
		name		"window"
		group		GROUP_NAME
		rect		0 0 WINDOW_WIDTH WINDOW_HEIGHT
		style		WINDOW_STYLE_FILLED
		backcolor	0.01 0.01 0.01 .95
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
	
// Logo //

#define LOGOBAR_WIDTH 96+16+96+16+64+16+64

	
	itemDef {
		name		"logoNQShadow"
		rect		$evalfloat(.5*(WINDOW_WIDTH-(LOGOBAR_WIDTH))+57+1) $evalfloat(10+1) 216 27
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_nq"
		forecolor	0 0 0 1
		visible		1
		decoration
	}

	itemDef {
		name		"logoNQ"
		rect		$evalfloat(.5*(WINDOW_WIDTH-(LOGOBAR_WIDTH))+57-1) $evalfloat(10-1) 246 27
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_nq"
		forecolor	1 1 1 1
		visible		1
		decoration
	}
